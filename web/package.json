{
  "name": "bid-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Before I Deploy — shared UI for the web app and the Tauri desktop apps (macOS, Windows, Linux).",
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/tokens-build.mjs --check && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "i18n": "node scripts/i18n-check.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
