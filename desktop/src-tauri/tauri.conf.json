{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Before I Deploy",
  "version": "0.1.0",
  "identifier": "app.beforeideploy.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [{ "title": "Before I Deploy", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "resources": { "../../engine": "engine" }
  }
}
