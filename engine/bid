#!/bin/zsh -f
# Before I Deploy — engine launcher. Sets up a login-like PATH, then runs the Node engine.
ENGINE_DIR="${0:A:h}"

# PATH captured by install.sh from your real Terminal session
[ -f "$ENGINE_DIR/env.zsh" ] && source "$ENGINE_DIR/env.zsh"

# the PATH from env.zsh (your Terminal) comes first, so nvm / asdf / volta pick the Node you chose;
# the usual install places are only a fallback (audit E12)
APP_SUPPORT="${BID_APP_DIR:-$HOME/Library/Application Support/BeforeIDeploy}"
BUNDLED_NODE="$ENGINE_DIR/runtime/$(/usr/bin/uname -m)/bin/node"
export PATH="$APP_SUPPORT/tools/bin:$PATH:$HOME/.volta/bin:$HOME/.asdf/shims:/opt/homebrew/bin:/usr/local/bin:$HOME/.bun/bin:$HOME/.local/bin:$HOME/Library/pnpm:$HOME/.npm-global/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export LANG="en_US.UTF-8" LC_ALL="en_US.UTF-8"

# nvm without the slow nvm.sh: prefer the default alias, else the newest installed version
if ! command -v node >/dev/null 2>&1 && [ -d "$HOME/.nvm/versions/node" ]; then
  NVM_DEFAULT=""
  [ -f "$HOME/.nvm/alias/default" ] && NVM_DEFAULT="$(cat "$HOME/.nvm/alias/default")"
  NODE_BIN=""
  if [ -n "$NVM_DEFAULT" ]; then
    NODE_BIN=( $HOME/.nvm/versions/node/v${NVM_DEFAULT#v}*/bin(N/) )
    NODE_BIN="${NODE_BIN[-1]}"
  fi
  if [ -z "$NODE_BIN" ]; then
    NODE_BIN=( $HOME/.nvm/versions/node/*/bin(Nn/) )
    NODE_BIN="${NODE_BIN[-1]}"
  fi
  [ -n "$NODE_BIN" ] && export PATH="$NODE_BIN:$PATH"
fi

# Project tools prefer the user's Node; the engine itself uses the verified bundled runtime.
# Do this only after constructing PATH, so npm and every installed provider are visible from Finder.
export PATH="$PATH:${BUNDLED_NODE:h}"
if [[ -z "${BID_NO_BUNDLED_NODE:-}" && -x "$BUNDLED_NODE" ]]; then
  export BID_NODE_RUNTIME="bundled"
  exec "$BUNDLED_NODE" "$ENGINE_DIR/src/bid.mjs" "$@"
fi

if ! command -v node >/dev/null 2>&1; then
  # no Node → no i18n catalog; the two hand-written languages are inlined here
  if [[ "${BID_LANG:-en}" == bg* ]]; then
    print -r -- '{"type":"result","ok":false,"code":"no_node","key":"engine.noNode","error":"Node.js не е намерен. Инсталирай го от nodejs.org или с Homebrew."}'
  else
    print -r -- '{"type":"result","ok":false,"code":"no_node","key":"engine.noNode","error":"Node.js was not found. Install it from nodejs.org or with Homebrew."}'
  fi
  exit 127
fi

# the engine needs Node 18+ (fetch, structuredClone); an older one would fail with a confusing syntax error
NODE_V="$(node --version 2>/dev/null)"
NODE_MAJOR="${${NODE_V#v}%%.*}"
if [[ "$NODE_MAJOR" == <-> ]] && (( NODE_MAJOR < 18 )); then
  if [[ "${BID_LANG:-en}" == bg* ]]; then
    print -r -- "{\"type\":\"result\",\"ok\":false,\"code\":\"no_node\",\"key\":\"engine.oldNode\",\"error\":\"Node.js $NODE_V е твърде стар — нужна е версия 18 или по-нова.\"}"
  else
    print -r -- "{\"type\":\"result\",\"ok\":false,\"code\":\"no_node\",\"key\":\"engine.oldNode\",\"error\":\"Node.js $NODE_V is too old — version 18 or newer is needed.\"}"
  fi
  exit 127
fi

exec node "$ENGINE_DIR/src/bid.mjs" "$@"
