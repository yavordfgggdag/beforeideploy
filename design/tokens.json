{
  "$schema": "bid.tokens/1",
  "$note": "Single source of truth for colours, type, spacing, radii, elevation and motion. scripts/tokens-build.mjs generates web/src/styles/tokens.css; the Swift Theme mirrors these values (check: node scripts/tokens-build.mjs --check).",
  "color": {
    "bg.window":       { "light": "#F5F5F7", "dark": "#1C1C1E" },
    "bg.sidebar":      { "light": "#ECECEE", "dark": "#161618" },
    "surface.1":       { "light": "#FFFFFF", "dark": "#232325" },
    "surface.2":       { "light": "#F2F2F4", "dark": "#2C2C2E" },
    "surface.hover":   { "light": "#E8E8ED", "dark": "#3A3A3C" },
    "surface.inset":   { "light": "#EDEDF0", "dark": "#1C1C1E" },
    "border.hairline": { "light": "rgba(0,0,0,0.10)", "dark": "#38383A" },
    "text.primary":    { "light": "#1D1D1F", "dark": "#F5F5F7" },
    "text.secondary":  { "light": "#5E5E63", "dark": "#A1A1A6" },
    "text.tertiary":   { "light": "#6E6E73", "dark": "#9A9AA0" },
    "accent.fill":     { "light": "#0A66D6", "dark": "#0A66D6" },
    "accent.text":     { "light": "#0A66D6", "dark": "#409CFF" },
    "accent.soft":     { "light": "rgba(10,102,214,0.12)", "dark": "rgba(64,156,255,0.16)" },
    "success.fill":    { "light": "#1E7F3C", "dark": "#1E7F3C" },
    "success.text":    { "light": "#1E7F3C", "dark": "#30D158" },
    "warning.fill":    { "light": "#B25000", "dark": "#B25000" },
    "warning.text":    { "light": "#B25000", "dark": "#FF9F0A" },
    "danger.fill":     { "light": "#D70015", "dark": "#D70015" },
    "danger.text":     { "light": "#D70015", "dark": "#FF6961" },
    "info.fill":       { "light": "#007A8A", "dark": "#007A8A" },
    "info.text":       { "light": "#007A8A", "dark": "#5AC8FA" },
    "brand.violet":    { "light": "#7A3FD6", "dark": "#B57BFF" },
    "scrim":           { "light": "rgba(0,0,0,0.25)", "dark": "rgba(0,0,0,0.45)" }
  },
  "font": {
    "family.ui": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "family.mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
    "size": { "display": 28, "title": 22, "headline": 17, "subhead": 14, "body": 13, "callout": 12, "caption": 11, "micro": 10 },
    "weight": { "display": 700, "title": 700, "headline": 600, "subhead": 600, "body": 400, "callout": 400, "caption": 400, "micro": 600 }
  },
  "space": { "xxs": 2, "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 20, "xxl": 24, "page": 32, "top": 40 },
  "radius": { "xs": 6, "s": 8, "m": 12, "l": 16, "xl": 20, "full": 999 },
  "elevation": {
    "card":    { "light": "0 1px 1.5px rgba(0,0,0,0.12)", "dark": "0 1px 1.5px rgba(0,0,0,0.20)" },
    "popover": { "light": "0 6px 14px rgba(0,0,0,0.14)", "dark": "0 6px 14px rgba(0,0,0,0.28)" },
    "modal":   { "light": "0 16px 40px rgba(0,0,0,0.18)", "dark": "0 16px 40px rgba(0,0,0,0.50)" }
  },
  "motion": { "quick": "160ms", "panel": "180ms", "standard": "280ms", "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
  "layout": { "contentMax": 1120, "sidebar": 248, "breakpoint.compact": 720, "breakpoint.medium": 1024 }
}
